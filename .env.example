# Copy to .env.local and fill in. Everything here is bundled into the app and visible to anyone
# who installs it, so never put secrets in EXPO_PUBLIC_* variables.
# Restart with `npx expo start --clear` after editing.

# --- Supabase (public by design; Row Level Security is the security boundary) ---
# Dashboard > Project Settings > API. Use the *publishable* key, never the secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- App behaviour ---
EXPO_PUBLIC_APP_ENV=development
# Shows the Sam/Alex quick-fill bar and prefilled credentials. Ignored in release builds (__DEV__),
# and must be false/absent for any production build.
EXPO_PUBLIC_ENABLE_DEV_LOGINS=true

# --- Optional: crash reporting (https://sentry.io > create a React Native project > copy the DSN) ---
EXPO_PUBLIC_SENTRY_DSN=

# --- Optional: legal and support links shown in Settings > About (hidden when empty) ---
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
