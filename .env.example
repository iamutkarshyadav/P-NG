# Copy to .env.local and fill in. Everything here is bundled into the app and visible
# to anyone who installs it, so never put secrets in EXPO_PUBLIC_* variables.

# --- Supabase (public by design; Row Level Security is the security boundary) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Google Sign-In (Google Cloud Console > APIs & Services > Credentials) ---
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# --- App behaviour ---
EXPO_PUBLIC_APP_ENV=development
# Shows the Sam/Alex quick-fill bar and prefilled credentials. Must be false or absent in production.
EXPO_PUBLIC_ENABLE_DEV_LOGINS=true
